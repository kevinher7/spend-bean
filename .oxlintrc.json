{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "promise", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": "off",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-native",
                  "react-native-android-widget",
                  "expo-router"
                ],
                "message": "core runs without React."
              },
              {
                "group": ["**/widget/**", "**/app/**"],
                "message": "core cannot depend on the widget or the app."
              },
              {
                "group": ["effect/http/FetchHttpClient"],
                "message": "core depends on HttpClient, not on a specific implementation."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Effect",
            "property": "provide",
            "message": "core leaves requirements open. Provide layers in app/ or widget/."
          },
          {
            "object": "Effect",
            "property": "runPromise",
            "message": "core never runs effects. Run them in app/ or widget/."
          },
          {
            "object": "Effect",
            "property": "runSync",
            "message": "core never runs effects. Run them in app/ or widget/."
          },
          {
            "object": "Effect",
            "property": "runFork",
            "message": "core never runs effects. Run them in app/ or widget/."
          }
        ]
      }
    },
    {
      "files": ["src/widget/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/app/**"],
                "message": "widget and app only share core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/widget/**"],
                "message": "widget and app only share core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/preview.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
